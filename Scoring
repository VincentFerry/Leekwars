        var prio = 0;
        if (!Cache.leeks[entity].ally) {
            return {prio : 0, value: 0};
        }
       	var value = effect[1];
		prio += effect[1] * effect[3] * entityPrio * 20;
        return {prio : prio / item.cost, value: value};
