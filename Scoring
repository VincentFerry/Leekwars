    public static Object getPrioPush(Array effect, integer cellFrom, integer cellTo, integer entity, Leek leek, Item item) {
        if (entity == -1) return {prio : 0, value : 0};
        integer dist = round(effect[1] * (1 + Cache.leeks[leek.id].agility / 100));
        integer pushDest = getCellTowardCell(Cache.leeks[entity].cell, cellFrom, -dist);
        if (pushDest == null || !Carte.isEmptyCell(pushDest)) return {prio : 0, value : 0};
        var prio = 0;
        if (!Cache.leeks[entity].ally) {
            prio += dist * 2;
        } else {
            prio -= dist * 2;
        }
        return {prio : prio / item.cost, value : dist};
    }

