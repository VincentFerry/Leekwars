class BoardState {
	Map<integer, integer> cell     = [:];
	Map<integer, real>    life     = [:];
	Map<integer, real>    relShield = [:];
	Map<integer, real>    absShield = [:];
	Map<integer, real>    tp       = [:];
	Map<integer, real>    mp       = [:];
	// usedItem[entityId][itemId] = count utilisé ce tour
	Map<integer, Map<integer, integer>> usedItem = [:];
	// cooldowns simulés : [entityId][itemId] = true si en CD
	Map<integer, Map<integer, boolean>> chipCD  = [:];
	// buffs de stats simulés : [entityId][statName] = points ajoutés ce tour
	// statName in {strength, agility, magic, resistance, wisdom, science}
	Map<integer, Map<string, real>> statBuff = [:];
	// items non cumulables déjà actifs sur une cible : [targetId][itemId] = true
	Map<integer, Map<integer, boolean>> appliedItemEffects = [:];
	// arme équipée par entité (-1 si aucune)
	Map<integer, integer> weapon = [:];
	integer selfId = -1;
	// index inverse cellule -> entityId (-1 si vide)
	Map<integer, integer> cellToEntity = [:];
	// score courant de l'état, maintenu incrémentalement
	real cachedScore = 0.0;

	// Construit le BoardState initial depuis Cache.leeks
	static BoardState fromCache() {
		BoardState s = new BoardState();
		s.selfId = getEntity();
		for (Leek leek in Cache.leeks) {
			integer id = leek.id;
			s.cell[id]      = leek.cell;
			s.life[id]      = leek.life;
			s.relShield[id] = leek.relativeShield;
			s.absShield[id] = leek.absoluteShield;
			s.tp[id]        = leek.tp;
			s.mp[id]        = leek.mp;
			s.weapon[id]    = leek.weapon != null ? leek.weapon.id : -1;
			s.usedItem[id]  = [:];
			s.chipCD[id]    = [:];
			s.statBuff[id]  = [:];
			s.appliedItemEffects[id] = [:];
			for (Array buff in leek.effects) {
				integer itemSource = buff[5];
				if (Action.isAlreadyBuff(id, itemSource)) {
					s.appliedItemEffects[id][itemSource] = true;
				}
			}
			for (integer itemId in arrayConcat(leek.weapons, leek.chips)) {
				s.usedItem[id][itemId] = leek.itemMaxUse[itemId] != null ? leek.itemMaxUse[itemId] : 0;
			}
			if (leek.chipsCooldown != null) {
				for (integer chipId : boolean inCD in leek.chipsCooldown) {
					s.chipCD[id][chipId] = inCD;
				}
			}
			if (leek.cell != null) {
				s.cellToEntity[leek.cell] = id;
			}
		}
		s.cachedScore = Evaluator.evaluateState(s);
		return s;
	}

	// Retourne le score courant de l'état (maintenu incrémentalement)
	real evaluate() {
		return this.cachedScore;
	}

	// Met à jour cachedScore pour les entités dont l'ancien score est stocké dans affected
	void updateAffectedScore(Map<integer, real> affected) {
		for (integer id : real oldScore in affected) {
			real newScore = Evaluator.scoreForLeek(this, Cache.leeks[id]);
			this.cachedScore += newScore - oldScore;
		}
	}

	// Entité sur une cellule (-1 si vide)
	integer entityOn(integer c) {
		if (mapContainsKey(this.cellToEntity, c)) return this.cellToEntity[c];
		return -1;
	}

	// Cellule libre selon l'état simulé (obstacles fixes + entités simulées)
	boolean isEmptyCell(integer? cell) {
		if (!cell) return false;
		if (getCellContent(cell) == CELL_OBSTACLE) return false;
		return !mapContainsKey(this.cellToEntity, cell);
	}

	// Cellules accessibles depuis cellIni avec mp, selon l'état simulé
	Map<integer, integer> getCellulesAccessibles(integer cellIni, integer mp) {
		if (mp <= 0) return [cellIni : 0];
		Map<integer, integer> res = [:];
		Map<integer, integer> frontier = [:];
		res[cellIni] = 0;
		frontier[cellIni] = 0;
		integer cpt = 0;
		while (cpt != mp) {
			Map<integer, integer> nextFrontier = [:];
			for (integer key : integer dist in frontier) {
				integer x = getCellX(key);
				integer y = getCellY(key);
				integer? cellToTest;
				cellToTest = getCellFromXY(x + 1, y);
				if (cellToTest != null && !mapContainsKey(res, cellToTest) && this.isEmptyCell(cellToTest)) {
					res[cellToTest] = cpt + 1;
					nextFrontier[cellToTest] = cpt + 1;
				}
				cellToTest = getCellFromXY(x, y + 1);
				if (cellToTest != null && !mapContainsKey(res, cellToTest) && this.isEmptyCell(cellToTest)) {
					res[cellToTest] = cpt + 1;
					nextFrontier[cellToTest] = cpt + 1;
				}
				cellToTest = getCellFromXY(x - 1, y);
				if (cellToTest != null && !mapContainsKey(res, cellToTest) && this.isEmptyCell(cellToTest)) {
					res[cellToTest] = cpt + 1;
					nextFrontier[cellToTest] = cpt + 1;
				}
				cellToTest = getCellFromXY(x, y - 1);
				if (cellToTest != null && !mapContainsKey(res, cellToTest) && this.isEmptyCell(cellToTest)) {
					res[cellToTest] = cpt + 1;
					nextFrontier[cellToTest] = cpt + 1;
				}
			}
			frontier = nextFrontier;
			cpt++;
		}
		return res;
	}

	// Calcule la cellule d'arrivée d'une entité poussée/attirée le long de la
	// ligne (fromCell -> entityCell), sur au plus nb cases. toward=true : on
	// rapproche l'entité du lanceur (attraction) ; false : on l'éloigne (poussée).
	// S'arrête sur un obstacle, une entité, le bord de carte, ou le lanceur.
	integer displacedCell(integer fromCell, integer entityCell, integer nb, boolean toward) {
		if (nb <= 0) return entityCell;
		integer fx = getCellX(fromCell); integer fy = getCellY(fromCell);
		integer ex = getCellX(entityCell); integer ey = getCellY(entityCell);
		integer dx = ex - fx; integer dy = ey - fy;
		integer stepX = 0; integer stepY = 0;
		if (dx != 0 && dy == 0) {
			stepX = dx > 0 ? 1 : -1;
		} else if (dy != 0 && dx == 0) {
			stepY = dy > 0 ? 1 : -1;
		} else {
			// Pas sur une ligne droite : déplacement non modélisé
			return entityCell;
		}
		if (toward) { stepX = -stepX; stepY = -stepY; }

		integer curX = ex; integer curY = ey;
		integer resultCell = entityCell;
		for (integer i = 0; i < nb; i++) {
			integer nx = curX + stepX; integer ny = curY + stepY;
			integer? nc = getCellFromXY(nx, ny);
			if (nc == null || nc == -1) break;
			if (getCellContent(nc) == CELL_OBSTACLE) break;
			if (this.entityOn(nc) != -1) break;
			if (toward && nc == fromCell) break; // ne pas dépasser le lanceur
			resultCell = nc;
			curX = nx; curY = ny;
		}
		return resultCell;
	}

	// Points de buff sur une stat (0 si aucun)
	real buffOf(integer id, string stat) {
		if (this.statBuff[id] == null) return 0.0;
		if (this.statBuff[id][stat] == null) return 0.0;
		return this.statBuff[id][stat];
	}

	// La cellule est-elle accessible depuis fromCell avec mp dispo ?
	boolean isReachable(integer fromCell, integer toCell, integer availMp) {
		if (fromCell == toCell) return true;
		integer? dist = getPathLength(fromCell, toCell);
		if (!dist) return false;
		return dist <= availMp;
	}

	// Applique une BSAction et renvoie un token d'undo (deltas)
	// BSAction : {leekId, itemId, cellFrom, cellTo, kind}
	// kind : KIND_ATTACK=0 | KIND_BUFF=1 | KIND_MOVE=2
	Object apply(Object a) {
		integer lid    = a.leekId;
		integer itemId = a.itemId;
		Map<integer, real> affected = [:];
		Object token   = {
			lid       : lid,
			itemId    : itemId,
			kind      : a.kind,
			prevCell  : this.cell[lid],
			prevLife  : [:],
			prevRelSh : [:],
			prevAbsSh : [:],
			prevTp    : this.tp[lid],
			prevMp    : this.mp[lid],
			prevUsed  : (this.usedItem[lid][itemId] != null ? this.usedItem[lid][itemId] : 0),
			prevCD    : (this.chipCD[lid][itemId] != null ? this.chipCD[lid][itemId] : false),
			prevWeapon : this.weapon[lid],
			movedEntities : [:],
			prevBuff  : [:],
			appliedEffects : [:], // targetId -> itemId -> true pour undo
		};

		Item item = Cache.items[itemId];

		// Coût MP (déplacement vers cellFrom)
		if (a.cellFrom != this.cell[lid] && a.kind != ActionGenerator.KIND_MOVE) {
			integer? pathCost = getPathLength(this.cell[lid], a.cellFrom);
			if (pathCost) {
				if (!mapContainsKey(affected, lid)) affected[lid] = Evaluator.scoreForLeek(this, Cache.leeks[lid]);
				this.mp[lid] -= pathCost;
				this.cellToEntity[this.cell[lid]] = -1;
				this.cell[lid] = a.cellFrom;
				this.cellToEntity[a.cellFrom] = lid;
			}
		}

		// Coût TP + changement d'arme
		integer weaponCost = 0;
		if (item.is_weapon && this.weapon[lid] != itemId) {
			weaponCost = 1;
			this.weapon[lid] = itemId;
		}
		if (!mapContainsKey(affected, lid)) affected[lid] = Evaluator.scoreForLeek(this, Cache.leeks[lid]);
		this.tp[lid] -= item.cost + weaponCost;

		// Incrémenter usedItem
		if (this.usedItem[lid][itemId] == null) this.usedItem[lid][itemId] = 0;
		this.usedItem[lid][itemId]++;

		// Marquer cooldown
		if (item.cooldown > 0 || item.cooldown == -1) {
			this.chipCD[lid][itemId] = true;
		}

		if (a.kind == ActionGenerator.KIND_MOVE && (itemId == CHIP_GRAPPLE || itemId == CHIP_BOXING_GLOVE)) {
			// Grappin (attire) / Gant de boxe (pousse) : déplacent LA CIBLE, pas le lanceur
			integer targetId = this.entityOn(a.cellTo);
			if (targetId != -1) {
				integer nb = 0;
				boolean toward = false;
				for (Array effect in item.effects) {
					if (effect[0] == EFFECT_ATTRACT) { nb = effect[1]; toward = true; }
					else if (effect[0] == EFFECT_PUSH) { nb = effect[1]; toward = false; }
				}
				integer newCell = this.displacedCell(this.cell[lid], this.cell[targetId], nb, toward);
				if (newCell != this.cell[targetId]) {
					token.movedEntities[targetId] = this.cell[targetId];
					this.cellToEntity[this.cell[targetId]] = -1;
					this.cell[targetId] = newCell;
					this.cellToEntity[newCell] = targetId;
				}
			}
		} else if (a.kind == ActionGenerator.KIND_MOVE) {
			// Action de déplacement pur (jump/téléport)
			token.movedEntities[lid] = this.cell[lid];
			this.cellToEntity[this.cell[lid]] = -1;
			this.cell[lid] = a.cellTo;
			this.cellToEntity[a.cellTo] = lid;
		} else {
			// Action d'attaque/buff : calcul d'impact sur la zone
			Array<integer> areaCells = item.is_weapon
				? getWeaponEffectiveArea(item.id, a.cellTo, a.cellFrom)
				: getChipEffectiveArea(item.id, a.cellTo, a.cellFrom);
			for (integer areaCell in areaCells) {
				integer targetId = this.entityOn(areaCell);
				if (targetId == -1) continue;
				Leek target = Cache.leeks[targetId];
				Leek caster = Cache.leeks[lid];

				// Puce non cumulable déjà active sur la cible : on ignore les effets non stackables
				boolean itemAlreadyActive = mapContainsKey(this.appliedItemEffects, targetId) && this.appliedItemEffects[targetId][itemId];

				// Sauvegarder état avant
				if (!mapContainsKey(token.prevLife, targetId)) {
					if (!mapContainsKey(affected, targetId)) affected[targetId] = Evaluator.scoreForLeek(this, Cache.leeks[targetId]);
					token.prevLife[targetId]  = this.life[targetId];
					token.prevRelSh[targetId] = this.relShield[targetId];
					token.prevAbsSh[targetId] = this.absShield[targetId];
				}

				real areaMulti = Carte.areaMultiplicator[getCellDistance(areaCell, a.cellTo)];
				// Buffs de stats simulés du lanceur (steroïde, etc.)
				real bStr = this.buffOf(lid, 'strength');
				real bAgi = this.buffOf(lid, 'agility');
				real bSci = this.buffOf(lid, 'science');
				boolean appliedNonStackable = false;
				for (Array effect in item.effects) {
					integer eff = effect[0];
					// Effet non cumulable déjà présent sur la cible : on ne le resimule pas
					if ((effect[5] & EFFECT_MODIFIER_STACKABLE) == 0 && itemAlreadyActive) continue;
					if (eff == EFFECT_DAMAGE) {
						Object res = DamageModel.resolveDamage(effect, caster, target, areaMulti, bStr, bAgi, this.relShield[targetId], this.absShield[targetId]);
						this.life[targetId] -= res.dealt;
						// vol de vie
						if (res.steal > 0) {
							if (!mapContainsKey(token.prevLife, lid)) {
								if (!mapContainsKey(affected, lid)) affected[lid] = Evaluator.scoreForLeek(this, Cache.leeks[lid]);
								token.prevLife[lid] = this.life[lid];
							}
							this.life[lid] += res.steal;
						}
					} else if (eff == EFFECT_LIFE_DAMAGE) {
						Object res = DamageModel.resolveLifeDamage(effect, caster, target, areaMulti, bAgi, this.relShield[targetId], this.absShield[targetId]);
						this.life[targetId] -= res.dealt;
					} else if (eff == EFFECT_NOVA_DAMAGE) {
						Object res = DamageModel.resolveNovaDamage(effect, caster, target, areaMulti, bSci);
						// nova réduit totalLife (simulé via absShield proxy, assez pour scoring)
					} else if (eff == EFFECT_HEAL || eff == EFFECT_RAW_HEAL) {
						real totLife = Cache.leeks[targetId].totalLife;
						real maxH = totLife - this.life[targetId];
						// Anti-overheal : ne créditer le soin que si la cible a perdu
						// au moins HEAL_MIN_MISSING_RATIO de sa vie max. Proche du plein
						// PV, un soin ne vaut pas la dépense de TP -> gain simulé nul,
						// donc le Planner ne le retiendra pas.
						if (maxH > totLife * ScoringConfig.HEAL_MIN_MISSING_RATIO) {
							real heal = effect[1] * areaMulti * (1.0 + caster.wisdom / 100.0);
							this.life[targetId] += heal > maxH ? maxH : heal;
						}
					} else if (eff == EFFECT_RELATIVE_SHIELD) {
						real val = effect[1] * areaMulti * (1.0 + caster.resistance / 100.0);
						this.relShield[targetId] += val;
					} else if (eff == EFFECT_ABSOLUTE_SHIELD) {
						real val = effect[1] * areaMulti * (1.0 + caster.resistance / 100.0);
						this.absShield[targetId] += val;
					} else if (eff == EFFECT_VULNERABILITY) {
						this.relShield[targetId] -= effect[1] * areaMulti;
					} else if (eff == EFFECT_ABSOLUTE_VULNERABILITY) {
						this.absShield[targetId] -= effect[1] * areaMulti;
					} else if (eff == EFFECT_INVERT) {
						// Inversion : swap positions
						integer otherCell = this.cell[targetId];
						token.movedEntities[targetId] = otherCell;
						token.movedEntities[lid]      = this.cell[lid];
						this.cellToEntity[this.cell[lid]] = targetId;
						this.cellToEntity[otherCell]      = lid;
						this.cell[targetId] = this.cell[lid];
						this.cell[lid]      = otherCell;
						// pénalité bouclier relatif de la cible (effet réel de l'inversion)
						this.relShield[targetId] -= 20;
					} else if (eff == EFFECT_PUSH || eff == EFFECT_ATTRACT) {
						// Déplacement simplifié : on met à jour cellToEntity
						token.movedEntities[targetId] = this.cell[targetId];
						this.cellToEntity[this.cell[targetId]] = -1;
						this.cell[targetId] = a.cellTo;
						this.cellToEntity[a.cellTo] = targetId;
					} else if (eff == EFFECT_BUFF_TP || eff == EFFECT_RAW_BUFF_TP) {
						if (!mapContainsKey(affected, targetId)) affected[targetId] = Evaluator.scoreForLeek(this, Cache.leeks[targetId]);
						this.tp[targetId] += effect[1];
					} else if (eff == EFFECT_BUFF_MP || eff == EFFECT_RAW_BUFF_MP) {
						if (!mapContainsKey(affected, targetId)) affected[targetId] = Evaluator.scoreForLeek(this, Cache.leeks[targetId]);
						this.mp[targetId] += effect[1];
					} else if (eff == EFFECT_BUFF_STRENGTH || eff == EFFECT_RAW_BUFF_STRENGTH) {
						this.applyStatBuff(token, affected, targetId, 'strength', effect, eff == EFFECT_BUFF_STRENGTH, areaMulti, caster);
					} else if (eff == EFFECT_BUFF_AGILITY || eff == EFFECT_RAW_BUFF_AGILITY) {
						this.applyStatBuff(token, affected, targetId, 'agility', effect, eff == EFFECT_BUFF_AGILITY, areaMulti, caster);
					} else if (eff == EFFECT_RAW_BUFF_MAGIC) {
						this.applyStatBuff(token, affected, targetId, 'magic', effect, false, areaMulti, caster);
					} else if (eff == EFFECT_BUFF_RESISTANCE || eff == EFFECT_RAW_BUFF_RESISTANCE) {
						this.applyStatBuff(token, affected, targetId, 'resistance', effect, eff == EFFECT_BUFF_RESISTANCE, areaMulti, caster);
					} else if (eff == EFFECT_BUFF_WISDOM || eff == EFFECT_RAW_BUFF_WISDOM) {
						this.applyStatBuff(token, affected, targetId, 'wisdom', effect, eff == EFFECT_BUFF_WISDOM, areaMulti, caster);
					} else if (eff == EFFECT_RAW_BUFF_SCIENCE) {
						this.applyStatBuff(token, affected, targetId, 'science', effect, false, areaMulti, caster);
					}
					// Les autres effets (shackle, poison, etc.) ne modifient pas
					// les champs trackés par BoardState ; ignorés pour la simulation
					if ((effect[5] & EFFECT_MODIFIER_STACKABLE) == 0) appliedNonStackable = true;
				}
				if (appliedNonStackable) {
					if (!mapContainsKey(this.appliedItemEffects, targetId)) this.appliedItemEffects[targetId] = [:];
					if (!mapContainsKey(token.appliedEffects, targetId)) token.appliedEffects[targetId] = [:];
					token.appliedEffects[targetId][itemId] = true;
					this.appliedItemEffects[targetId][itemId] = true;
				}
			}
		}

		this.updateAffectedScore(affected);
		return token;
	}

	// Ajoute un buff de stat en sauvegardant la valeur précédente dans le token
	// scaleScience : true pour les buffs non-raw (multipliés par la science du lanceur)
	void applyStatBuff(Object token, Map<integer, real> affected, integer targetId, string stat, Array effect, boolean scaleScience, real areaMulti, Leek caster) {
		if (!mapContainsKey(this.statBuff, targetId)) this.statBuff[targetId] = [:];
		real val = effect[1] * areaMulti;
		if (scaleScience) val *= (1.0 + caster.science / 100.0);
		if (!mapContainsKey(token.prevBuff, targetId)) {
			if (!mapContainsKey(affected, targetId)) affected[targetId] = Evaluator.scoreForLeek(this, Cache.leeks[targetId]);
			token.prevBuff[targetId] = [:];
		}
		if (!mapContainsKey(token.prevBuff[targetId], stat)) {
			token.prevBuff[targetId][stat] = mapContainsKey(this.statBuff[targetId], stat) ? this.statBuff[targetId][stat] : 0.0;
		}
		if (!mapContainsKey(this.statBuff[targetId], stat)) this.statBuff[targetId][stat] = 0.0;
		this.statBuff[targetId][stat] += val;
	}

	// Annule un apply via son token
	void undo(Object token) {
		integer lid    = token.lid;
		integer itemId = token.itemId;
		Map<integer, real> affected = [:];

		// Pré-calculer les anciens scores des entités qui vont être restaurées
		affected[lid] = Evaluator.scoreForLeek(this, Cache.leeks[lid]);
		for (integer targetId : real prevLife in token.prevLife) {
			affected[targetId] = Evaluator.scoreForLeek(this, Cache.leeks[targetId]);
		}
		for (integer targetId : real prevRel in token.prevRelSh) {
			affected[targetId] = Evaluator.scoreForLeek(this, Cache.leeks[targetId]);
		}
		for (integer targetId : real prevAbs in token.prevAbsSh) {
			affected[targetId] = Evaluator.scoreForLeek(this, Cache.leeks[targetId]);
		}
		for (integer targetId : Map<string, real> prevStats in token.prevBuff) {
			affected[targetId] = Evaluator.scoreForLeek(this, Cache.leeks[targetId]);
		}

		// Restaurer TP/MP
		this.tp[lid] = token.prevTp;
		this.mp[lid] = token.prevMp;

		// Restaurer arme équipée
		this.weapon[lid] = token.prevWeapon;

		// Restaurer usedItem
		this.usedItem[lid][itemId] = token.prevUsed;

		// Restaurer CD
		this.chipCD[lid][itemId] = token.prevCD;

		// Restaurer position du caster
		if (this.cell[lid] != token.prevCell) {
			this.cellToEntity[this.cell[lid]] = -1;
			this.cell[lid] = token.prevCell;
			this.cellToEntity[token.prevCell] = lid;
		}

		// Restaurer vie / boucliers des cibles
		for (integer targetId : real prevLife in token.prevLife) {
			this.life[targetId] = prevLife;
		}
		for (integer targetId : real prevRel in token.prevRelSh) {
			this.relShield[targetId] = prevRel;
		}
		for (integer targetId : real prevAbs in token.prevAbsSh) {
			this.absShield[targetId] = prevAbs;
		}

		// Restaurer les buffs de stats
		for (integer targetId : Map<string, real> prevStats in token.prevBuff) {
			for (string stat : real prevVal in prevStats) {
				this.statBuff[targetId][stat] = prevVal;
			}
		}

		// Restaurer positions des entités déplacées
		for (integer movedId : integer prevC in token.movedEntities) {
			this.cellToEntity[this.cell[movedId]] = -1;
			this.cell[movedId] = prevC;
			this.cellToEntity[prevC] = movedId;
		}

		// Restaurer les effets non cumulables appliqués
		for (integer targetId : Map<integer, boolean> effects in token.appliedEffects) {
			for (integer appliedItemId : boolean val in effects) {
				if (mapContainsKey(this.appliedItemEffects, targetId)) {
					this.appliedItemEffects[targetId][appliedItemId] = false;
				}
			}
		}

		this.updateAffectedScore(affected);
	}
}
