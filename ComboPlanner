include('MacroActionGenerator');

class ComboPlanner {
	static Array macros;
	static Array bestCombo;
	static real bestScore;
	static BoardState s;
	static integer leekId;
	static integer maxDepth;
	static integer nodesExplored;
	static integer depthReached;
	static integer beamWidthMax;

	// Recherche le meilleur plan pour leekId dans l'état s
	static Array plan(BoardState state, integer lid) {
		OpBudget.begin('ComboPlanner');
		ComboPlanner.s = state;
		ComboPlanner.leekId = lid;
		ComboPlanner.bestCombo = [];
		ComboPlanner.bestScore = Evaluator.evaluateState(state);
		ComboPlanner.nodesExplored = 0;
		ComboPlanner.depthReached = 0;
		ComboPlanner.beamWidthMax = 0;

		// Générer les macro-actions et ne garder que les plus prometteuses
		ComboPlanner.macros = MacroActionGenerator.generate(state, lid);
		ComboPlanner.macros = arraySort(ComboPlanner.macros, function(a, b) {
			if (a.estimatedGain > b.estimatedGain) return -1;
			if (a.estimatedGain < b.estimatedGain) return 1;
			return 0;
		});
		integer keep = count(ComboPlanner.macros) < 80 ? count(ComboPlanner.macros) : 80;
		if (keep < count(ComboPlanner.macros)) {
			ComboPlanner.macros = arraySlice(ComboPlanner.macros, 0, keep);
		}

		// Profondeur max bornée par les TP disponibles
		real initialTp = state.tp[lid];
		ComboPlanner.maxDepth = initialTp < 10 ? round(initialTp) : 10;

		ComboPlanner.searchBeam();

		OpBudget.end('ComboPlanner');
		debug('ComboPlanner : score=' + ComboPlanner.bestScore + ', nb actions=' + count(ComboPlanner.bestCombo)
			+ ', nodes=' + ComboPlanner.nodesExplored + ', depth=' + ComboPlanner.depthReached + ', beamW=' + ComboPlanner.beamWidthMax);
		if (Cache.DEBUG_PLANNER) ComboPlanner.logPlan(state, ComboPlanner.bestCombo, ComboPlanner.bestScore);
		return ComboPlanner.bestCombo;
	}

	// Vérifie qu'une macro peut être jouée dans l'état courant
	static boolean isApplicable(Object macro) {
		integer lid = ComboPlanner.leekId;
		Item item = Cache.items[macro.itemId];

		// Coût TP, incluant le changement d'arme
		integer weaponCost = (item.is_weapon && ComboPlanner.s.weapon[lid] != item.id) ? 1 : 0;
		if (ComboPlanner.s.tp[lid] < item.cost + weaponCost) return false;

		// Cooldown simulé
		if (ComboPlanner.s.chipCD[lid][macro.itemId] == true) return false;

		// maxUse
		integer used = mapContainsKey(ComboPlanner.s.usedItem[lid], macro.itemId)
			? ComboPlanner.s.usedItem[lid][macro.itemId]
			: 0;
		if (used >= item.maxUse) return false;

		// Position compatible : on ne peut exécuter une macro que depuis la cellule prévue
		if (macro.cellFrom != ComboPlanner.s.cell[lid]) return false;

		return true;
	}

	// Beam search itératif : largeur adaptative au budget restant
	static void searchBeam() {
		Array frontier = [
			{actions: [], score: ComboPlanner.bestScore, macros: ComboPlanner.macros}
		];

		for (integer depth = 0; depth < ComboPlanner.maxDepth; depth++) {
			if (!OpBudget.canContinue(0.20)) return;

			integer beamW = OpBudget.beamWidthForRemaining();
			Array next = [];

			for (Object node in frontier) {
				if (!OpBudget.canContinue(0.20)) return;

				// Appliquer le chemin du nœud pour reconstruire son état
				Array tokens = [];
				for (Object a in node.actions) {
					push(tokens, ComboPlanner.s.apply(a));
				}

				// Explorer chaque macro disponible
				for (Object macro in node.macros) {
					if (!OpBudget.canContinue(0.20)) return;
					if (!ComboPlanner.isApplicable(macro)) continue;

					Object token = ComboPlanner.s.apply(macro);
					Array childActions = clone(node.actions);
					push(childActions, macro);
					real score = Evaluator.evaluateState(ComboPlanner.s);

					// Après un déplacement, régénérer les macros depuis la nouvelle position
					Array childMacros = node.macros;
					if (macro.kind == ActionGenerator.KIND_MOVE) {
						childMacros = MacroActionGenerator.generate(ComboPlanner.s, ComboPlanner.leekId);
						childMacros = arraySort(childMacros, function(a, b) {
							if (a.estimatedGain > b.estimatedGain) return -1;
							if (a.estimatedGain < b.estimatedGain) return 1;
							return 0;
						});
						integer keep = count(childMacros) < 20 ? count(childMacros) : 20;
						if (keep < count(childMacros)) {
							childMacros = arraySlice(childMacros, 0, keep);
						}
					}

					push(next, {
						actions: childActions,
						score: score,
						macros: childMacros,
						cell: ComboPlanner.s.cell[ComboPlanner.leekId],
						tp: ComboPlanner.s.tp[ComboPlanner.leekId],
						mp: ComboPlanner.s.mp[ComboPlanner.leekId],
						weapon: ComboPlanner.s.weapon[ComboPlanner.leekId]
					});
					ComboPlanner.nodesExplored++;

					if (score > ComboPlanner.bestScore) {
						ComboPlanner.bestScore = score;
						ComboPlanner.bestCombo = clone(childActions);
					}

					ComboPlanner.s.undo(token);
				}

				// Annuler le chemin du nœud
				Array tokensRev = clone(tokens);
				reverse(tokensRev);
				for (Object tok in tokensRev) {
					ComboPlanner.s.undo(tok);
				}
			}

			if (isEmpty(next)) return;

			// Élagage par dominance : garder le meilleur score par état (cell, tp, mp, weapon)
			Map<integer, Object> bestByState = [:];
			for (Object n in next) {
				integer key = (n.cell << 18) | ((n.tp | 0) << 12) | ((n.mp | 0) << 6) | (n.weapon + 1);
				if (mapContainsKey(bestByState, key)) {
					Object prev = bestByState[key];
					if (n.score > prev.score) bestByState[key] = n;
				} else {
					bestByState[key] = n;
				}
			}
			next = [];
			for (Object n in bestByState) {
				push(next, n);
			}

			next = arraySort(next, function(a, b) {
				if (a.score > b.score) return -1;
				if (a.score < b.score) return 1;
				return 0;
			});
			if (count(next) > beamW) {
				next = arraySlice(next, 0, beamW);
			}
			if (beamW > ComboPlanner.beamWidthMax) ComboPlanner.beamWidthMax = beamW;
			if (depth + 1 > ComboPlanner.depthReached) ComboPlanner.depthReached = depth + 1;
			frontier = next;
		}
	}

	// Affiche le plan final avec le gain marginal de chaque action
	static void logPlan(BoardState state, Array actions, real bestScore) {
		if (isEmpty(actions)) {
			debug('ComboPlanner : aucune action retenue');
			return;
		}
		debug('ComboPlanner plan final (score=' + bestScore + '):');
		real prevScore = state.evaluate();
		Array tokens = [];
		for (Object a in actions) {
			Object token = state.apply(a);
			push(tokens, token);
			real newScore = state.evaluate();
			real gain = newScore - prevScore;
			prevScore = newScore;
			string line = '- ' + Cache.items[a.itemId].name + ' from ' + a.cellFrom + ' to ' + a.cellTo + ' | gain=' + gain;
			if (a.entityToRes != -1) {
				line += ' res=' + a.entityToRes;
			}
			debug(line);
		}
		Array tokensRev = clone(tokens);
		reverse(tokensRev);
		for (Object tok in tokensRev) {
			state.undo(tok);
		}
	}
}
