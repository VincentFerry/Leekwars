class Evaluator {
	// Décompose le score d'un état en composantes lisibles
	// (plus haut = mieux pour nous)
	static Object explainState(BoardState s) {
		OpBudget.begin('Evaluator.explainState');
		Object result = {
			total: 0.0,
			lifeAlly: 0.0,
			lifeEnemy: 0.0,
			shieldsAlly: 0.0,
			shieldsEnemy: 0.0,
			resourcesAlly: 0.0,
			buffs: 0.0,
			kills: 0.0,
			deaths: 0.0
		};
		integer selfId = s.selfId;

		for (Leek leek in Cache.leeks) {
			integer id = leek.id;
			real life     = s.life[id];
			real relSh    = s.relShield[id];
			real absSh    = s.absShield[id];
			real sign     = leek.ally ? 1.0 : -1.0;

			// Vie restante (pondérée par priorité ennemi)
			real lifeScore = life;
			if (!leek.ally && mapContainsKey(Cache.enemiesPrio, id)) {
				lifeScore *= (Cache.enemiesPrio[id] / 3.0);
			}
			result.total += sign * lifeScore;
			if (leek.ally) {
				result.lifeAlly += lifeScore;
			} else {
				result.lifeEnemy -= lifeScore;
			}

			// Boucliers alliés : positifs = bons pour nous
			if (leek.ally) {
				real sh = relSh * ScoringConfig.W_RELATIVE_SHIELD + absSh * ScoringConfig.W_ABSOLUTE_SHIELD;
				result.total += sh;
				result.shieldsAlly += sh;
			} else {
				// Boucliers ennemis : positifs = mauvais pour nous.
				// Crédite les actions de setup (vulnérabilité) qui rendent
				// relShield/absShield ennemis négatifs, pour que le Planner
				// retienne l'ordre "vulnérabilité -> attaques" sans que le beam
				// n'élague le setup avant que le combo ne paye.
				real enemyPrio = mapContainsKey(Cache.enemiesPrio, id) ? (Cache.enemiesPrio[id] / 3.0) : 1.0;
				real sh = relSh * ScoringConfig.W_VULNERABILITY * enemyPrio + absSh * ScoringConfig.W_ABSOLUTE_SHIELD * enemyPrio;
				result.total -= sh;
				result.shieldsEnemy -= sh;
			}

			// TP/MP restants (alliés uniquement)
			if (leek.ally) {
				real res = s.tp[id] * ScoringConfig.W_TP * 0.1 + s.mp[id] * ScoringConfig.W_MP * 0.1;
				result.total += res;
				result.resourcesAlly += res;
			}

			// Buffs de stats simulés (alliés uniquement) : valorise les puces de boost
			// Gate : seulement si le leek a encore au moins 2 TP (peut attaquer après)
			// et qu'il existe au moins un ennemi en vie (buff stérile sinon).
			if (leek.ally && s.statBuff[id] != null && s.tp[id] >= 2 && !isEmpty(Cache.enemiesTargets)) {
				real b = 0.0;
				b += s.buffOf(id, 'strength')   * ScoringConfig.W_BUFF_STRENGTH;
				b += s.buffOf(id, 'agility')    * ScoringConfig.W_BUFF_AGILITY;
				b += s.buffOf(id, 'magic')      * ScoringConfig.W_BUFF_MAGIC;
				b += s.buffOf(id, 'resistance') * ScoringConfig.W_BUFF_RESISTANCE;
				b += s.buffOf(id, 'wisdom')     * ScoringConfig.W_BUFF_WISDOM;
				b += s.buffOf(id, 'science')    * ScoringConfig.W_BUFF_SCIENCE;
				result.total += b;
				result.buffs += b;
			}

			// Kill bonus : ennemi à 0 = forte récompense
			if (!leek.ally && life <= 0) {
				real k = 5000.0 * (mapContainsKey(Cache.enemiesPrio, id) ? Cache.enemiesPrio[id] : 1.0);
				result.total += k;
				result.kills += k;
			}
			// Mort alliée = forte pénalité
			if (leek.ally && life <= 0 && leek.type == ENTITY_LEEK) {
				result.total -= 5000.0;
				result.deaths -= 5000.0;
			}
		}

		OpBudget.end('Evaluator.explainState');
		return result;
	}

	// Valeur globale d'un état de plateau (plus haut = mieux pour nous)
	static real evaluateState(BoardState s) {
		return Evaluator.explainState(s).total;
	}

	// Gain marginal d'une action = evaluateState(après) - evaluateState(avant)
	// Passe par apply/undo pour ne pas cloner le BoardState
	static real marginalGain(BoardState s, Object a) {
		real before = Evaluator.evaluateState(s);
		Object token = s.apply(a);
		real after  = Evaluator.evaluateState(s);
		s.undo(token);
		return after - before;
	}
}
