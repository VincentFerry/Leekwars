class Evaluator {

	// Valeur globale d'un état de plateau (plus haut = mieux pour nous)

	static real evaluateState(BoardState s) {

		real score = 0.0;

		for (Leek leek in Cache.leeks) {

			score += Evaluator.scoreForLeek(s, leek);

		}

		return score;

	}



	// Contribution d'un seul poireau au score total.

	// Utilisée par l'évaluateur incrémental du BoardState.

	static real scoreForLeek(BoardState s, Leek leek) {

		integer id = leek.id;

		real life     = s.life[id];

		real relSh    = s.relShield[id];

		real absSh    = s.absShield[id];

		real sign     = leek.ally ? 1.0 : -1.0;

		real score    = 0.0;



		// Vie restante (pondérée par priorité ennemi)

		real lifeScore = life;

		real enemyPrio = 1.0;
		integer enemyPrioRaw = 1;
		if (!leek.ally && mapContainsKey(Cache.enemiesPrio, id)) {
			enemyPrioRaw = Cache.enemiesPrio[id];
			enemyPrio = enemyPrioRaw / 3.0;
			lifeScore *= enemyPrio;
		}

		score += sign * lifeScore;



		// Boucliers alliés : positifs = bons pour nous

		if (leek.ally) {

			score += relSh * ScoringConfig.W_RELATIVE_SHIELD;

			score += absSh * ScoringConfig.W_ABSOLUTE_SHIELD;

		} else {

			// Boucliers ennemis : positifs = mauvais pour nous.

			// Crédite les actions de setup (vulnérabilité) qui rendent

			// relShield/absShield ennemis négatifs, pour que le Planner

			// retienne l'ordre "vulnérabilité -> attaques" sans que le beam

			// n'élague le setup avant que le combo ne paye.

			score -= relSh * ScoringConfig.W_VULNERABILITY * enemyPrio;

			score -= absSh * ScoringConfig.W_ABSOLUTE_SHIELD * enemyPrio;

		}



		// TP/MP restants (alliés uniquement)

		if (leek.ally) {

			score += s.tp[id] * ScoringConfig.W_TP * 0.1;

			score += s.mp[id] * ScoringConfig.W_MP * 0.1;

		}



		// Buffs de stats simulés (alliés uniquement) : valorise les puces de boost

		// Gate : seulement si le leek a encore au moins 2 TP (peut attaquer après)

		// et qu'il existe au moins un ennemi en vie (buff stérile sinon).

		if (leek.ally && mapContainsKey(s.statBuff, id) && s.tp[id] >= 2 && !isEmpty(Cache.enemiesTargets)) {

			score += s.buffOf(id, 'strength')   * ScoringConfig.W_BUFF_STRENGTH;

			score += s.buffOf(id, 'agility')    * ScoringConfig.W_BUFF_AGILITY;

			score += s.buffOf(id, 'magic')      * ScoringConfig.W_BUFF_MAGIC;

			score += s.buffOf(id, 'resistance') * ScoringConfig.W_BUFF_RESISTANCE;

			score += s.buffOf(id, 'wisdom')     * ScoringConfig.W_BUFF_WISDOM;

			score += s.buffOf(id, 'science')    * ScoringConfig.W_BUFF_SCIENCE;

		}



		// Kill bonus : ennemi à 0 = forte récompense

		if (!leek.ally && life <= 0) {

			score += 5000.0 * enemyPrioRaw;

		}

		// Mort alliée = forte pénalité

		if (leek.ally && life <= 0 && leek.type == ENTITY_LEEK) {

			score -= 5000.0;

		}

		return score;

	}



	// Décompose le score par grandes catégories (debug)

	static Object explainState(BoardState s) {

		real lifeAlly = 0.0;

		real lifeEnemy = 0.0;

		real shieldsAlly = 0.0;

		real shieldsEnemy = 0.0;

		real resourcesAlly = 0.0;

		real buffs = 0.0;

		integer kills = 0;

		integer deaths = 0;

		for (Leek leek in Cache.leeks) {

			integer id = leek.id;

			if (leek.ally) {

				lifeAlly += s.life[id];

				shieldsAlly += s.relShield[id] * ScoringConfig.W_RELATIVE_SHIELD + s.absShield[id] * ScoringConfig.W_ABSOLUTE_SHIELD;

				resourcesAlly += s.tp[id] * ScoringConfig.W_TP * 0.1 + s.mp[id] * ScoringConfig.W_MP * 0.1;

				if (s.life[id] <= 0 && leek.type == ENTITY_LEEK) deaths++;

				if (mapContainsKey(s.statBuff, id) && s.tp[id] >= 2 && !isEmpty(Cache.enemiesTargets)) {

					buffs += s.buffOf(id, 'strength')   * ScoringConfig.W_BUFF_STRENGTH;

					buffs += s.buffOf(id, 'agility')    * ScoringConfig.W_BUFF_AGILITY;

					buffs += s.buffOf(id, 'magic')      * ScoringConfig.W_BUFF_MAGIC;

					buffs += s.buffOf(id, 'resistance') * ScoringConfig.W_BUFF_RESISTANCE;

					buffs += s.buffOf(id, 'wisdom')     * ScoringConfig.W_BUFF_WISDOM;

					buffs += s.buffOf(id, 'science')    * ScoringConfig.W_BUFF_SCIENCE;

				}

			} else {

				real prio = mapContainsKey(Cache.enemiesPrio, id) ? Cache.enemiesPrio[id] / 3.0 : 1.0;

				lifeEnemy += s.life[id] * prio;

				shieldsEnemy -= (s.relShield[id] * ScoringConfig.W_VULNERABILITY + s.absShield[id] * ScoringConfig.W_ABSOLUTE_SHIELD) * prio;

				if (s.life[id] <= 0) kills++;

			}

		}

		return {

			total: lifeAlly - lifeEnemy + shieldsAlly + shieldsEnemy + resourcesAlly + buffs + kills * 5000.0 - deaths * 5000.0,

			lifeAlly: lifeAlly,

			lifeEnemy: lifeEnemy,

			shieldsAlly: shieldsAlly,

			shieldsEnemy: shieldsEnemy,

			resourcesAlly: resourcesAlly,

			buffs: buffs,

			kills: kills,

			deaths: deaths

		};

	}



	// Gain marginal d'une action = evaluateState(après) - evaluateState(avant)

	// Passe par apply/undo pour ne pas cloner le BoardState

	static real marginalGain(BoardState s, Object a) {

		real before = s.evaluate();

		Object token = s.apply(a);

		real after  = s.evaluate();

		s.undo(token);

		return after - before;

	}

}
