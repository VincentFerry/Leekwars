class ScoringConfig {
	// Poids de base (repris des constantes actuelles de Scoring)
	static real W_RELATIVE_SHIELD   = 6.0;
	static real W_ABSOLUTE_SHIELD   = 0.8;
	static real W_VULNERABILITY     = 2.0;
	static real W_HEAL              = 1.0;
	static real W_NOVA              = 0.5;
	static real W_GENERIC_STATS     = 0.2;
	static real W_STRENGTH          = 0.4;
	static real W_RESISTANCE        = 0.7;
	static real W_MAGIC             = 0.6;
	static real W_TP                = 120.0;
	static real W_MP                = 60.0;
	static real W_DAMAGE_RETURN     = 1.0;

	// Poids des buffs de stats simulés (récompense pour puces de boost)
	// Calibrés pour que boost+attaque > attaque seule sans être trop agressifs
	static real W_BUFF_STRENGTH   = 3.0;   // 1 pt force = ~1% dégâts en plus -> fort impact
	static real W_BUFF_AGILITY    = 0.5;   // critique : impact secondaire
	static real W_BUFF_MAGIC      = 2.5;   // similaire force mais magie
	static real W_BUFF_RESISTANCE = 1.5;   // défensif : modéré
	static real W_BUFF_WISDOM     = 0.4;   // vol de vie : secondaire
	static real W_BUFF_SCIENCE    = 1.0;   // nova : modéré

	// Poids tactiques
	static real W_AOE_EXTRA_TARGET  = 1.0;
	static real W_PUSH_INTO_CLUSTER = 50.0;
	static real W_SURVIVAL          = 1.0;

	// Surcharges par type de combat
	// Structure : fightType -> nom_poids -> valeur
	static Map<integer, Map<string, real>> overrides = [
		FIGHT_TYPE_FARMER : [
			"W_TP" : 120.0,
			"W_MP" : 60.0,
		],
		FIGHT_TYPE_BATTLE_ROYALE : [
			"W_TP" : 100.0,
			"W_MP" : 50.0,
		],
	];

	// Multiplicateurs tour 1 (repris depuis Action.getPriority)
	static Map<integer, real> turn1Multipliers = [
		CHIP_REFLEXES       : 1000.0,
		CHIP_WARM_UP        : 1000.0,
		CHIP_PRISM          : 75.0,
		CHIP_KNOWLEDGE      : 50.0,
		CHIP_SOLIDIFICATION : 50.0,
		CHIP_RAGE           : 5.0,
	];

	// Accessor avec fallback + override fightType
	static real get(string key) {
		integer ft = Cache.fightType;
		if (mapContainsKey(ScoringConfig.overrides, ft)) {
			if (mapContainsKey(ScoringConfig.overrides[ft], key)) {
				return ScoringConfig.overrides[ft][key];
			}
		}
		if (key == "W_RELATIVE_SHIELD")   return ScoringConfig.W_RELATIVE_SHIELD;
		if (key == "W_ABSOLUTE_SHIELD")   return ScoringConfig.W_ABSOLUTE_SHIELD;
		if (key == "W_VULNERABILITY")     return ScoringConfig.W_VULNERABILITY;
		if (key == "W_HEAL")              return ScoringConfig.W_HEAL;
		if (key == "W_NOVA")              return ScoringConfig.W_NOVA;
		if (key == "W_GENERIC_STATS")     return ScoringConfig.W_GENERIC_STATS;
		if (key == "W_STRENGTH")          return ScoringConfig.W_STRENGTH;
		if (key == "W_RESISTANCE")        return ScoringConfig.W_RESISTANCE;
		if (key == "W_MAGIC")             return ScoringConfig.W_MAGIC;
		if (key == "W_TP")                return ScoringConfig.W_TP;
		if (key == "W_MP")                return ScoringConfig.W_MP;
		if (key == "W_DAMAGE_RETURN")     return ScoringConfig.W_DAMAGE_RETURN;
		if (key == "W_BUFF_STRENGTH")     return ScoringConfig.W_BUFF_STRENGTH;
		if (key == "W_BUFF_AGILITY")      return ScoringConfig.W_BUFF_AGILITY;
		if (key == "W_BUFF_MAGIC")        return ScoringConfig.W_BUFF_MAGIC;
		if (key == "W_BUFF_RESISTANCE")   return ScoringConfig.W_BUFF_RESISTANCE;
		if (key == "W_BUFF_WISDOM")       return ScoringConfig.W_BUFF_WISDOM;
		if (key == "W_BUFF_SCIENCE")      return ScoringConfig.W_BUFF_SCIENCE;
		if (key == "W_AOE_EXTRA_TARGET")  return ScoringConfig.W_AOE_EXTRA_TARGET;
		if (key == "W_PUSH_INTO_CLUSTER") return ScoringConfig.W_PUSH_INTO_CLUSTER;
		if (key == "W_SURVIVAL")          return ScoringConfig.W_SURVIVAL;
		debugW("ScoringConfig.get : clé inconnue '" + key + "'");
		return 1.0;
	}
}
