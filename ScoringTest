/* Tests de non-régression pour le nouveau pipeline (BoardState + Evaluator + Planner).
 * Activer active=true en 1v1 sans obstacles pour vérifier les scenarios. */
class ScoringTest {

    static boolean active = false;

    static void run() {
        integer me = getEntity();
        integer enemy = getNearestEnemy();

        // ---- Scénario 1 : boost stat → le nœud boost doit être valorisé positivement ----
        BoardState s = BoardState.fromCache();
        real scoreBefore = Evaluator.evaluateState(s);

        // Simuler un buff de force sur soi (+100 force)
        if (s.statBuff[me] == null) s.statBuff[me] = [:];
        s.statBuff[me]['strength'] = 100.0;
        real scoreAfterBuff = Evaluator.evaluateState(s);
        boolean buffValued = scoreAfterBuff > scoreBefore;
        debug('[ScoringTest] S1 buff valorisé (+strength) : ' + buffValued
            + ' (delta=' + (scoreAfterBuff - scoreBefore) + ')');

        // ---- Scénario 2 : DamageModel avec bonus force ----
        Leek caster = Cache.leeks[me];
        Leek target = Cache.leeks[enemy];
        if (caster != null && target != null) {
            Array fakeEffect = [EFFECT_DAMAGE, 100, 100, 0, 0, 0];
            Object res0 = DamageModel.resolveDamage(fakeEffect, caster, target, 1.0, 0.0, 0.0);
            Object res1 = DamageModel.resolveDamage(fakeEffect, caster, target, 1.0, 100.0, 0.0);
            boolean buffIncreaseDmg = res1.dealt > res0.dealt;
            debug('[ScoringTest] S2 buff force augmente dégâts simulés : ' + buffIncreaseDmg
                + ' (' + res0.dealt + ' -> ' + res1.dealt + ')');
        }

        // ---- Scénario 3 : gate buff stérile (TP < 2) → buff non valorisé ----
        BoardState s2 = BoardState.fromCache();
        s2.tp[me] = 1; // plus assez de TP pour attaquer après
        if (s2.statBuff[me] == null) s2.statBuff[me] = [:];
        s2.statBuff[me]['strength'] = 100.0;
        real scoreGate = Evaluator.evaluateState(s2);
        real scoreGateBase = scoreBefore - (s.tp[me] - 1) * ScoringConfig.W_TP * 0.1;
        boolean gateWorking = scoreGate <= scoreGateBase + 1.0; // buff non compté
        debug('[ScoringTest] S3 gate buff stérile (TP=1) : ' + gateWorking);

        pause();
    }
}