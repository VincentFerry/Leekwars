include('ActionGenerator');
include('Evaluator');

class MacroActionGenerator {
	// Nombre de macro-actions conservées par item
	static integer TOP_K = 3;

	// Génère les macro-actions les plus prometteuses pour le leek dans l'état s
	static Array generate(BoardState s, integer leekId) {
		OpBudget.begin('MacroActionGenerator');

		Array rawActions = arrayConcat(
			ActionGenerator.attacks(s, leekId),
			ActionGenerator.moves(s, leekId)
		);

		// Scorer chaque action brute et la transformer en macro-action
		Array scored = [];
		for (Object a in rawActions) {
			if (!OpBudget.canContinue(0.05)) break;
			real score = MacroActionGenerator.estimateScore(s, leekId, a);
			Object macro = {
				leekId     : a.leekId,
				itemId     : a.itemId,
				cellFrom   : a.cellFrom,
				cellTo     : a.cellTo,
				kind       : a.kind,
				entityToRes: a.entityToRes,
				estimatedGain: score
			};
			push(scored, macro);
		}

		// Grouper par itemId et garder les TOP_K meilleures
		Map<integer, Array> byItem = [:];
		for (Object macro in scored) {
			if (!mapContainsKey(byItem, macro.itemId)) {
				byItem[macro.itemId] = [];
			}
			push(byItem[macro.itemId], macro);
		}

		Array result = [];
		for (integer itemId : Array macros in byItem) {
			macros = arraySort(macros, function(a, b) {
				if (a.estimatedGain > b.estimatedGain) return -1;
				if (a.estimatedGain < b.estimatedGain) return 1;
				return 0;
			});
			integer keep = count(macros) < MacroActionGenerator.TOP_K ? count(macros) : MacroActionGenerator.TOP_K;
			for (integer i = 0; i < keep; i++) {
				push(result, macros[i]);
			}
		}

		OpBudget.end('MacroActionGenerator');
		return result;
	}

	// Estimation du gain réel d'une action brute (apply + evaluate + undo)
	static real estimateScore(BoardState s, integer leekId, Object a) {
		if (a.kind == ActionGenerator.KIND_MOVE) {
			return MacroActionGenerator.estimateMoveScore(leekId, a);
		}
		return Evaluator.marginalGain(s, a);
	}

	// Heuristique rapide pour les actions de déplacement
	static real estimateMoveScore(integer leekId, Object a) {
		if (a.itemId == CHIP_JUMP) {
			// Sauts proches des ennemis prioritaires = meilleur score
			real score = 50.0;
			integer cellTo = a.cellTo;
			for (integer enemyId in Cache.enemiesTargets) {
				Leek enemy = Cache.leeks[enemyId];
				if (enemy.life <= 0) continue;
				integer dist = getCellDistance(cellTo, enemy.cell);
				if (dist < 8) score += (8 - dist) * 10.0;
			}
			return score;
		} else if (a.itemId == CHIP_INVERSION) {
			return 40.0;
		} else if (a.itemId == CHIP_GRAPPLE || a.itemId == CHIP_BOXING_GLOVE) {
			return 30.0;
		}
		return 0.0;
	}
}
